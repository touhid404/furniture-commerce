model OutboxJob {
  id String @id @default(uuid()) @db.Uuid
  type String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  error String?
  createdAt DateTime @default(now())
  @@index([status,availableAt])
}
