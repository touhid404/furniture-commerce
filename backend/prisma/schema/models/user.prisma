model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  role Role @default(CUSTOMER)
  disabled Boolean @default(false)
  emailVerifiedAt DateTime?
  totpSecret String?
  createdAt DateTime @default(now())
  sessions Session[]
  addresses Address[]
  cart Cart?
  orders Order[]
  tokens AuthToken[]
  reviews Review[]
}
