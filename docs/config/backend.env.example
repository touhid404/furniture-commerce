# Copy to the ignored root .env.local; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
STORE_CONFIG_PATH=config/stores/default.json
PORT=3001
# Select the intended branch before applying reviewed migrations.
NEON_BRANCH=production
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.YOUR_REGION.neon.tech
AWS_ACCESS_KEY_ID=REPLACE_WITH_BRANCH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BRANCH_SECRET_KEY
AWS_REGION=us-east-2
STORAGE_BUCKET=assets
PUBLIC_APP_URL=http://127.0.0.1:3001
# Production requires long random secrets; MFA key is 64 hexadecimal characters.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Explicit demo-only opt-in. Leave unset in production.
# DEMO_SEED=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
