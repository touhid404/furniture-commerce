# Copy to an ignored environment file; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
STORE_CONFIG_PATH=config/stores/default.json
PORT=3001
# Select a development branch before running migrations or seeding.
# APP_ENV_FILE=.env.development.local
# Production requires long random secrets; MFA key is 64 hexadecimal characters.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Explicit demo-only opt-in. Leave unset in production.
# DEMO_SEED=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
