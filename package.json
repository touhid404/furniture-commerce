{
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "name": "furniture-commerce",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Reference-driven furniture commerce platform with React, Express, Prisma and Neon",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && npm run typecheck && vite build --config frontend/vite.config.ts && tsc -p backend/tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server/backend/src/server.js",
    "check:docs": "node scripts/validate-docs.mjs",
    "check:config": "tsx scripts/check-config.ts",
    "test": "tsx --test tests/config.test.ts tests/domain.test.ts",
    "test:db": "tsx scripts/verify-database.ts",
    "test:e2e": "playwright test",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx backend/prisma/seed.ts",
    "worker": "tsx backend/src/worker.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:integration": "tsx --test tests/integration/commerce.test.ts",
    "test:worker": "tsx --test tests/integration/worker.test.ts",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\" \"backend/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css}\" \"backend/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.ts\" \"*.{ts,json}\""
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
