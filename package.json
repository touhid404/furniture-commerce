{
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "name": "furniture-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Reference-driven furniture commerce platform with React, Express, Prisma and Neon",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/apps/api/src/server.js",
    "check:docs": "node scripts/validate-docs.mjs",
    "check:config": "tsx scripts/check-config.ts",
    "test": "tsx --test tests/config.test.ts",
    "test:db": "tsx scripts/verify-database.ts",
    "test:e2e": "playwright test"
  }
}
